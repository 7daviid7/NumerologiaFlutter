    "version": "0.2.0",
    "configurations": [
        {
            "name": "numerologia_flutter(desktop)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file=.env"
            ]
        },
        {
            "name": "numerologia_flutter (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "toolArgs": [
                "--dart-define-from-file=.env"
            ]
        },
        {
            "name": "numerologia_flutter (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "toolArgs": [
                "--dart-define-from-file=.env"
            ]
        },
        {
            "name": "numerologia_flutter (Web)",
            "request": "launch",
            "type": "dart",
            "args": [
                "-d",
                "chrome"
            ],
            "toolArgs": [
                "--dart-define-from-file=.env"
            ]
        }
    ]
}