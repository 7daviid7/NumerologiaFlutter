rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Col·lecció PRIVADA "interpretations"
    // ARA SÍ: Només l'admin (autenticat) pot llegir i escriure.
    match /interpretations/{docId} {
       allow read, write: if request.auth != null;
    }

    // 2. Col·lecció PÚBLICA "shared_interpretations"
    // 2. Col·lecció PÚBLICA "shared_interpretations"
    match /shared_interpretations/{docId} {
      // Tothom pot LLEGIR (incloent llistats/queries per als testimonis)
      allow read: if true;
      
      // Admin pot crear
      allow create: if request.auth != null;

      // Actualitzar: Permetem a tothom (públic) afegir feedback,
      // PERÒ protegim els camps crítics (originalDocId, interpretation, etc.)
      allow update: if 
        // 1. Camps que NO poden canviar (Immutables)
        request.resource.data.originalDocId == resource.data.originalDocId &&
        request.resource.data.interpretation == resource.data.interpretation &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        
        // 2. Opcional: Podríem validar també que només es toqui 'guestFeedback'
        // però amb la immutabilitat dels anteriors ja protegim el més important.
        true;
    }
  }
}
